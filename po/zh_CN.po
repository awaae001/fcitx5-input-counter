msgid ""
msgstr ""
"Project-Id-Version: fcitx5-input-counter 0.2.3\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_CN\n"

msgid "Input Counter"
msgstr "输入计数器"

msgid "Filter repeated keys"
msgstr "过滤连发"

msgid "Filter held-key counts in game input contexts; input method commits still count."
msgstr "过滤游戏输入上下文中的长按连发计数；输入法提交的文本仍正常计数。"

msgid "Steam game AppIDs"
msgstr "Steam 游戏 AppID"

msgid "Separate AppIDs with commas or whitespace; leave empty to select all games."
msgstr "AppID 用逗号或空白分隔；留空表示全部游戏。"

msgid "Steam status fallback"
msgstr "Steam 运行状态兜底"

msgid "Use Steam game running status when the input program cannot be identified."
msgstr "无法识别输入程序时，使用 Steam 游戏运行状态作为过滤依据。"

msgid "Is this a game?"
msgstr "这是游戏吗？"

msgid "Steam detected %1 (AppID: %2). Is it a game?"
msgstr "Steam 检测到 %1（AppID：%2）。这是游戏吗？"

msgid "Yes, this is a game"
msgstr "是，这是游戏"

msgid "No, ignore"
msgstr "否，忽略"

msgid "Game detected"
msgstr "检测到游戏"

msgid "Detected that %1 (AppID: %2) has started."
msgstr "检测到 %1（AppID：%2）已启动。"

msgid ""
"Committed characters are counted by hour and stored locally; no text is "
"retained."
msgstr "按小时统计已上屏字数并本地保存，不保留输入内容。"

msgid "Could not open the statistics database: %1"
msgstr "无法打开统计数据库：%1"

msgid "Overview"
msgstr "概览"

msgid "Total"
msgstr "总计"

msgid "Today"
msgstr "今日"

msgid "Last 24 hours"
msgstr "近 24 小时"

msgid "Last 7 days"
msgstr "近 7 天"

msgid "Last 30 days"
msgstr "近 30 天"

msgid "Last 12 months"
msgstr "过去一年"

msgid "All time"
msgstr "有史以来"

msgid "Custom"
msgstr "自定义"

msgid "Custom time range"
msgstr "自定义时间范围"

msgid "Start time"
msgstr "开始时间"

msgid "End time"
msgstr "结束时间"

msgid "Time scale"
msgstr "时间刻度"

msgid "1 hour"
msgstr "1 小时"

msgid "6 hours"
msgstr "6 小时"

msgid "12 hours"
msgstr "12 小时"

msgid "1 day"
msgstr "1 天"

msgid "1 week"
msgstr "1 周"

msgid "1 month"
msgstr "1 个月"

msgid "Apply"
msgstr "应用"

msgid "Bars"
msgstr "柱形数"

msgid "%1 / %2 (over limit)"
msgstr "%1 / %2（超出上限）"

msgid "Invalid range"
msgstr "范围无效"

msgid "At most %1 bars can be queried at once. This limit is intended to prevent lag caused by excessive data during database queries, D-Bus transfers, and chart rendering."
msgstr "单次最多查询 %1 个柱形。此举措意在避免因数据库查询、D-Bus 传输和图表渲染的数据量过大造成的卡顿"

msgid "Why is there a limit?"
msgstr "为什么会有上限？"

msgid "Refresh"
msgstr "刷新"

msgid "Clear all"
msgstr "清零"

msgid "Clear all statistics"
msgstr "清空统计"

msgid ""
"This permanently deletes all recorded input statistics. Continue?"
msgstr "将永久删除所有已记录的输入统计，是否继续？"

msgid "Failed to clear statistics: %1"
msgstr "清空统计失败：%1"

msgid "Failed to read statistics: %1"
msgstr "读取统计失败：%1"

msgid "Data unavailable"
msgstr "数据不可用"

msgid "Connected"
msgstr "已连接"

msgid "No data recorded yet"
msgstr "暂无记录"
