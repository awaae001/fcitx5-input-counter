msgid "Input Counter"
msgstr "输入计数器"

msgid "Quick counter"
msgstr "快捷计数器"

msgid "Count"
msgstr "计数"

msgid "Start recording"
msgstr "开始记录"

msgid "Pause recording"
msgstr "暂停记录"

msgid "Reset"
msgstr "归零"

msgid ""
"Committed characters are counted by hour and stored locally; no text is "
"retained."
msgstr "按小时统计上屏字符并本地保存，不保留输入内容。"

msgid "Could not open the statistics database: %1"
msgstr "无法打开统计数据库：%1"

msgid "Overview"
msgstr "概览"

msgid "Total"
msgstr "总计"

msgid "Today"
msgstr "今日"

msgid "Last 24 hours"
msgstr "近 24 小时"

msgid "Last 7 days"
msgstr "近 7 天"

msgid "Last 30 days"
msgstr "近 30 天"

msgid "Last 12 months"
msgstr "过去一年"

msgid "All time"
msgstr "有史以来"

msgid "Custom"
msgstr "自定义"

msgid "Custom time range"
msgstr "自定义时间范围"

msgid "Start time"
msgstr "开始时间"

msgid "End time"
msgstr "结束时间"

msgid "Time scale"
msgstr "时间刻度"

msgid "1 hour"
msgstr "1 小时"

msgid "6 hours"
msgstr "6 小时"

msgid "12 hours"
msgstr "12 小时"

msgid "1 day"
msgstr "1 天"

msgid "1 week"
msgstr "1 周"

msgid "1 month"
msgstr "1 个月"

msgid "Apply"
msgstr "应用"

msgid "Bars"
msgstr "柱形数"

msgid "%1 / %2 (over limit)"
msgstr "%1 / %2（超出上限）"

msgid "Invalid range"
msgstr "范围无效"

msgid "Refresh"
msgstr "刷新"

msgid "Clear all…"
msgstr "清零…"

msgid "Clear all statistics"
msgstr "清空统计"

msgid ""
"This permanently deletes all recorded input statistics. Continue?"
msgstr "将永久删除所有已记录的输入统计，是否继续？"

msgid "Failed to clear statistics: %1"
msgstr "清空统计失败：%1"

msgid "Failed to read statistics: %1"
msgstr "读取统计失败：%1"

msgid "Data unavailable"
msgstr "数据不可用"

msgid "Connected"
msgstr "已连接"

msgid "No data recorded yet"
msgstr "暂无记录"
